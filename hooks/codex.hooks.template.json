{
  "description": "RenderGuard CSS/GUI/SVG",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node __ROOT__/bin/render-guard.mjs hook-pre",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node __ROOT__/bin/render-guard.mjs hook-bash",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node __ROOT__/bin/render-guard.mjs hook-post",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node __ROOT__/bin/render-guard.mjs hook-stop",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
